"""
Build, run and deploy the partyline examples, and run the end-to-end and browser tests against them.
Also the workspace checks that need a pinned toolchain or tool: the minimum Rust version and the
Markdown link check.
"""
type Examples {
  let ws: Workspace!
  let rustContainer: Container!
  let wranglerVersion: String!
  let compatibilityDate: String

  new(
    ws: Workspace!,
    """
    Version (image tag) to use from the official Rust image repository as a base container.
    """
    rustVersion: String! = "latest",
    """
    Wrangler version to install.
    """
    wranglerVersion: String! = "4",
    """
    Tailwind CSS CLI version that dx compiles the web clients' styles with.
    """
    tailwindVersion: String! = "v4.1.5",
    """
    Workers compatibility date to run every example with, such as 2025-04-01. Default: the date
    in each wrangler.toml.
    """
    compatibilityDate: String,
  ) {
    # Commands run from the repository root, wherever Dagger is called from.
    self.ws = ws.withWorkdir(".")

    # The dioxus module stops dx from downloading tools, so the web clients' Tailwind CSS step
    # needs the CLI on the PATH.
    let tailwindArch = if (toString(Dagger.defaultPlatform).contains("arm64")) { "arm64" } else { "x64" }
    self.rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withFile(
        "/usr/local/bin/tailwindcss",
        Dagger.http(
          `https://github.com/tailwindlabs/tailwindcss/releases/download/${tailwindVersion}/tailwindcss-linux-${tailwindArch}`,
        ),
        permissions: 493, # 0755
      )

    self.wranglerVersion = wranglerVersion
    self.compatibilityDate = compatibilityDate

    self
  }

  """
  The smallest partyline app: follow an order's status and notes live.
  """
  orders: Example! {
    self.example("orders")
  }

  """
  Authentication: sign-in, access tokens, and sign-out.
  """
  chat: Example! {
    self
      .example("chat")
      .withDevVariable("SESSION_SECRET", "e2e-secret-of-at-least-32-characters")
  }

  """
  The live poll demo.
  """
  poll: Example! {
    self.example("poll")
  }

  """
  The Worker the end-to-end tests run against for hooks only tests need.
  """
  fixture: Example! {
    Example(
      name: "fixture",
      wranglerVersion: self.wranglerVersion,
      config: self.ws.file("e2e/fixture/wrangler.toml"),
      worker: self.worker("e2e/fixture"),
      compatibilityDate: self.compatibilityDate,
    )
  }

  """
  Run the end-to-end tests against the orders and chat examples and the fixture under wrangler dev.
  """
  endToEnd: Void @check {
    self.endToEndWith(self.orders, self.fixture, self.chat)
  }

  """
  Run the end-to-end tests with every Worker at the oldest supported compatibility date.

  Hibernation, the WebSocket auto-response, and close handling change with compatibility flags,
  so the hub is tested at the oldest date it supports as well as at the date the examples pin.
  """
  endToEndOldestCompatibilityDate: Void @check {
    let date = "2025-04-01"

    self.endToEndWith(
      self.orders.withCompatibilityDate(date),
      self.fixture.withCompatibilityDate(date),
      self.chat.withCompatibilityDate(date),
    )
  }

  """
  Build the published crates natively and for wasm32 with the minimum supported Rust version.
  """
  msrv: Void @check {
    let crates = ["-p", "partyline", "-p", "partyline-client", "-p", "partyline-dioxus", "-p", "partyline-worker"]

    rust(self.ws, Dagger.container.from("rust:1.91"), targets: ["wasm32-unknown-unknown"])
      .container
      .withExec(["cargo", "check", "--locked"] + crates)
      .withExec(["cargo", "check", "--locked", "--target", "wasm32-unknown-unknown"] + crates)
      .sync

    null
  }

  """
  Check the relative links and anchors in the Markdown files. Links to other sites are not checked.
  """
  links: Void @check {
    Dagger
      .container
      .from("lycheeverse/lychee:0.24.2")
      .withMountedDirectory("/src", self.ws.directory("."))
      .withWorkdir("/src")
      .withExec([
        "lychee", "--offline", "--no-progress", "--include-fragments",
        "--exclude-path", "target", "--exclude-path", ".devenv", "--exclude-path", ".claude",
        ".",
      ])
      .sync

    null
  }

  """
  Run the end-to-end tests against these Workers under wrangler dev.
  """
  let endToEndWith(orders: Example!, fixture: Example!, chat: Example!): Void {
    rust(self.ws, self.rustContainer)
      .container
      .withServiceBinding("orders", orders.service)
      .withServiceBinding("fixture", fixture.service)
      .withServiceBinding("chat", chat.service)
      .withEnvVariable("PARTYLINE_E2E_URL", "http://orders:8787")
      .withEnvVariable("PARTYLINE_E2E_FIXTURE_URL", "http://fixture:8787")
      .withEnvVariable("PARTYLINE_E2E_CHAT_URL", "http://chat:8787")
      .withExec(["cargo", "test", "--locked", "-p", "partyline-e2e", "--", "--test-threads=1"])
      .sync

    null
  }

  """
  Run the browser transport tests in headless Chromium against the orders example under wrangler dev.
  """
  browser: Void @check {
    let wasmBindgenVersion = Dagger
      .cargoLock(self.ws, file: self.ws.file("Cargo.lock"))
      .findOne("wasm-bindgen")!
      .version

    let container = self
      .rustContainer
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "chromium", "chromium-driver"])
      .{ Dagger.wasmTools.withTool(WasmToolsTool.WASM_BINDGEN, wasmBindgenVersion).apply(_) }

    # Chromium refuses to run as root without --no-sandbox.
    let webdriver = `{"goog:chromeOptions": {"args": ["--headless=new", "--no-sandbox", "--disable-dev-shm-usage"]}}`

    rust(self.ws, container, targets: ["wasm32-unknown-unknown"])
      .container
      .withNewFile("crates/partyline-client/webdriver.json", webdriver)
      .withServiceBinding("orders", self.orders.service)
      .withEnvVariable("CHROMEDRIVER", "/usr/bin/chromedriver")
      .withEnvVariable("CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER", "wasm-bindgen-test-runner")
      .withEnvVariable("PARTYLINE_TEST_URL", "http://orders:8787")
      .withExec([
        "cargo", "test", "--locked",
        "-p", "partyline-client",
        "--target", "wasm32-unknown-unknown",
        "--features", "web-wake",
        "--test", "browser",
      ])
      .sync

    null
  }

  """
  An example with a Worker (in <name>/worker) and a Dioxus web client (in <name>/web).
  """
  let example(name: String!): Example! {
    let dir = "examples/" + name

    Example(
      name: name,
      wranglerVersion: self.wranglerVersion,
      config: self.ws.file(dir + "/worker/wrangler.toml"),
      worker: self.worker(dir + "/worker"),
      web: Dagger
        .dioxus(ws: self.ws.withWorkdir(dir + "/web"), container: self.rustContainer)
        .bundle(
          release: true,
          debugSymbols: false,
          platform: DioxusPlatform.WEB,
          package: name + "-web",
        )
        .directory("public"),
      compatibilityDate: self.compatibilityDate,
    )
  }

  """
  Build the Worker crate in the given directory with worker-build.
  """
  let worker(dir: String!): Directory! {
    Dagger
      .workerBuild(ws: self.ws.withWorkdir(dir), container: self.rustContainer)
      .build(release: true)
  }
}

let rust(ws: Workspace!, container: Container!, targets: [String!]! = []): Rust! {
  Dagger.rust(ws: ws, container: container, targets: targets)
}

"""
A partyline example: a Worker and, optionally, its web client.
"""
type Example {
  """
  Name of the example.
  """
  name: String!

  let wrangler: Wrangler!
  let config: File!
  let worker: Directory!
  let web: Directory
  let devVariables: [Variable!]!
  let compatibilityDate: String

  new(
    name: String!,
    """
    Wrangler version to install.
    """
    wranglerVersion: String!,
    """
    Wrangler configuration of the Worker.
    """
    config: File!,
    """
    worker-build output of the Worker.
    """
    worker: Directory!,
    """
    Web client served as static assets.
    """
    web: Directory,
    """
    Workers compatibility date to use instead of the one in wrangler.toml.
    """
    compatibilityDate: String,
  ) {
    self.name = name
    self.wrangler = Dagger.wrangler(version: wranglerVersion)
    self.config = config
    self.worker = worker
    self.web = web
    self.devVariables = []
    self.compatibilityDate = compatibilityDate

    self
  }

  """
  Set a variable for wrangler dev (written to .dev.vars).
  """
  withDevVariable(name: String!, value: String!): Example! {
    self.devVariables += [Variable(name: name, value: value)]

    self
  }

  """
  Use this Workers compatibility date, such as 2025-04-01, instead of the one in wrangler.toml.
  """
  withCompatibilityDate(date: String!): Example! {
    self.compatibilityDate = date

    self
  }

  """
  Deployable Worker: wrangler.toml, the Worker in build/, and the web client in public/.
  """
  bundle: Directory! {
    # The Worker is already built: Wrangler must not run worker-build itself.
    let buildStep = "[build]\ncommand = \"worker-build --release\"\n"
    let config = self.config.contents
    if (!config.contains(buildStep)) {
      raise `${self.name}: wrangler.toml has no "${buildStep}" step to remove`
    }

    # Every wrangler.toml pins this date. Update it here when the examples move to a newer one.
    let pinnedDate = "compatibility_date = \"2026-09-01\"\n"
    let date = self.compatibilityDate
    if (date != null) {
      if (!config.contains(pinnedDate)) {
        raise `${self.name}: wrangler.toml has no "${pinnedDate}" line to replace`
      }
    }
    let dated = if (date != null) {
      config.replace(pinnedDate, `compatibility_date = "${date}"\n`)
    } else {
      config
    }

    Dagger
      .directory
      .withNewFile("wrangler.toml", dated.replace(buildStep, ""))
      .withDirectory("build", self.worker)
      .{
        let web = self.web
        if (web != null) { _.withDirectory("public", web) } else { _ }
      }
  }

  """
  Build the Worker and the web client.
  """
  build: Void @check {
    self.bundle.sync

    null
  }

  """
  Run the example locally with wrangler dev on port 8787.
  """
  service: Service! @up {
    let vars = self.devVariables.map { `${_.name}=${_.value}\n` }.join("")

    self.wrangler.dev(
      self.bundle.{ if (vars != "") { _.withNewFile(".dev.vars", vars) } else { _ } },
    )
  }

  """
  Deploy the example to Cloudflare Workers. Secrets are managed on the Workers, outside Dagger.
  """
  deploy(
    """
    Account ID for the Cloudflare account.
    """
    accountId: String!,
    """
    API token for the Cloudflare account.
    """
    apiToken: Secret!,
  ): Void @cache(policy: FunctionCachePolicy.Never) {
    self
      .wrangler
      .deploy(self.bundle, accountId: accountId, apiToken: apiToken)
      .sync

    null
  }
}

type Variable {
  name: String!
  value: String!
}
